{
  "name": "@woodwry/ai-unit-test-workstation",
  "version": "0.1.7",
  "description": "AI Unit Test Workstation desktop client for generating Java unit tests with remote backend services.",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": "22.14.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:maven-fixture": "mvn.cmd -f fixtures/multi-class-generation/pom.xml test verify",
    "typecheck": "tsc --noEmit",
    "package:win": "powershell -ExecutionPolicy Bypass -File packaging/windows/generate-branding-assets.ps1 && npm run build && electron-builder --config electron-builder.json --win nsis --x64",
    "package:client:win": "powershell -ExecutionPolicy Bypass -File packaging/windows/generate-branding-assets.ps1 && npm run build && electron-builder --config electron-builder.client.json --win nsis --x64",
    "package:client:mac": "npm run build && electron-builder --config electron-builder.client.json --mac dmg --universal",
    "package:client:linux": "npm run build && electron-builder --config electron-builder.client.json --linux tar.gz --x64",
    "dev:remote": "node scripts/start-remote-workstation.mjs dev",
    "start:remote": "node scripts/start-remote-workstation.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "electron": "44.4.5",
    "yauzl": "2.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "22.20.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "electron-builder": "26.0.12",
    "typescript": "5.9.3",
    "@codingame/monaco-vscode-api": "34.1.3",
    "@codingame/monaco-vscode-configuration-service-override": "34.1.3",
    "@codingame/monaco-vscode-files-service-override": "34.1.3",
    "@codingame/monaco-vscode-host-service-override": "34.1.3",
    "@codingame/monaco-vscode-quickaccess-service-override": "34.1.3",
    "@codingame/monaco-vscode-textmate-service-override": "34.1.3",
    "@codingame/monaco-vscode-theme-service-override": "34.1.3",
    "@vitejs/plugin-react": "4.7.0",
    "electron-vite": "2.3.0",
    "lucide-react": "1.22.0",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@34.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.21",
    "@types/yauzl": "2.10.3"
  },
  "homepage": "https://github.com/woodwry/AI-Unit-Test-Workstation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodwry/AI-Unit-Test-Workstation.git"
  },
  "bugs": {
    "url": "https://github.com/woodwry/AI-Unit-Test-Workstation/issues"
  },
  "bin": {
    "ai-unit-test-workstation": "scripts/start-remote-workstation.mjs"
  },
  "files": [
    "out/main/**",
    "out/preload/**",
    "out/renderer/**",
    "assets/branding/**",
    "scripts/start-remote-workstation.mjs",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
